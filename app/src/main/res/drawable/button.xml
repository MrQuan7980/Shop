<!-- res/drawable/gradient_background.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:centerColor="@color/light_gray"
                android:startColor="@color/new_color"
                android:endColor="#FFFFFF"
                android:angle="90" />
