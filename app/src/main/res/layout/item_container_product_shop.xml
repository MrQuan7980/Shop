<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/_120sdp"
    android:layout_marginTop="@dimen/_3sdp"
    android:padding="@dimen/_1sdp"
    android:background="@drawable/product_sop"
    android:layout_marginBottom="@dimen/_3sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/imageProduct"
        app:riv_corner_radius="@dimen/_5sdp"
        android:src="@drawable/iphone"
        android:layout_marginStart="@dimen/_2sdp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="@dimen/_110sdp"
        android:layout_height="@dimen/_110sdp"/>

    <TextView
        android:id="@+id/textTitle"
        android:textSize="@dimen/_13sdp"
        android:textColor="@color/black"
        android:maxLines="1"
        android:textStyle="bold"
        android:ellipsize="end"
        android:layout_marginEnd="@dimen/_5sdp"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginTop="@dimen/_7sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/imageProduct"
        android:text="Iphone 14 pro max mới nhất bên chúng tôi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/post"
        android:textColor="@color/black"
        android:text="Posting date"
        android:textSize="@dimen/_11sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginStart="@dimen/_65sdp"
        app:layout_constraintTop_toBottomOf="@id/textTitle"
        app:layout_constraintStart_toEndOf="@id/imageProduct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/posting_date"
        android:text="10/10/2003"
        android:textStyle="bold"
        android:textSize="@dimen/_11sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:layout_marginStart="@dimen/_4sdp"
        app:layout_constraintTop_toBottomOf="@id/textTitle"
        app:layout_constraintStart_toEndOf="@id/post"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/quantity_product"
        android:text="Quantity "
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="@dimen/_11sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:layout_marginStart="@dimen/_5sdp"
        app:layout_constraintTop_toBottomOf="@id/post"
        app:layout_constraintStart_toEndOf="@id/imageProduct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/quantity"
        android:text="20"
        android:textColor="@color/black"
        android:textSize="@dimen/_11sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:layout_marginStart="@dimen/_2sdp"
        app:layout_constraintTop_toBottomOf="@id/post"
        app:layout_constraintStart_toEndOf="@id/quantity_product"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/dola"
        android:text="$"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:layout_marginStart="@dimen/_27sdp"
        app:layout_constraintTop_toBottomOf="@id/post"
        app:layout_constraintStart_toEndOf="@id/quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/money"
        android:text="20.00"
        android:textColor="@color/black"
        android:textSize="@dimen/_11sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:layout_marginStart="@dimen/_2sdp"
        app:layout_constraintTop_toBottomOf="@id/post"
        app:layout_constraintStart_toEndOf="@id/dola"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/sold_product"
        android:text="Sold "
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="@dimen/_11sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:layout_marginStart="@dimen/_27sdp"
        app:layout_constraintTop_toBottomOf="@id/post"
        app:layout_constraintStart_toEndOf="@id/money"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:id="@+id/sold"
        android:text="10"
        android:textColor="@color/black"
        android:textSize="@dimen/_11sdp"
        android:layout_marginTop="@dimen/_7sdp"
        android:layout_marginStart="@dimen/_2sdp"
        app:layout_constraintTop_toBottomOf="@id/post"
        app:layout_constraintStart_toEndOf="@id/sold_product"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:weightSum="2"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/_1sdp"
        android:layout_marginStart="@dimen/_2sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quantity"
        app:layout_constraintStart_toEndOf="@id/imageProduct"
        android:layout_width="0dp"
        android:layout_marginEnd="@dimen/_2sdp"
        android:layout_height="@dimen/_45sdp">

        <androidx.appcompat.widget.AppCompatButton
            android:text="Edit Product"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/_2sdp"
            android:textSize="@dimen/_11sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:textColor="@color/black"
            android:textAllCaps="false"
            android:layout_marginEnd="@dimen/_2sdp"
            android:background="@drawable/button"
            android:layout_width="0dp"
            android:layout_height="@dimen/_37sdp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="0dp"
            android:layout_height="@dimen/_37sdp"
            android:layout_marginStart="@dimen/_2sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_2sdp"
            android:layout_weight="1"
            android:background="@drawable/button"
            android:text="Delete Product"
            android:textAllCaps="false"
            android:textColor="@color/design_default_color_error"
            android:textSize="@dimen/_11sdp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>